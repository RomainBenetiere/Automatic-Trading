# =============================================================================
# Market Analysis & Investment Recommendation System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- Ghostfolio ---
GHOSTFOLIO_URL=http://ghostfolio.local:3333
GHOSTFOLIO_TOKEN=your_ghostfolio_security_token

# --- Financial Modeling Prep ---
# Market data: "yahoo" (free, worldwide incl. Euronext/PEA) or "fmp"
MARKET_DATA_PROVIDER=yahoo
# Optional symbol remapping to Yahoo tickers (ISINs are auto-resolved)
# YAHOO_SYMBOL_MAP=CW8=CW8.PA,FR0010315770=CW8.PA
# Only needed if MARKET_DATA_PROVIDER=fmp
FMP_API_KEY=

# --- Bitvavo ---
BITVAVO_API_KEY=your_bitvavo_api_key
BITVAVO_API_SECRET=your_bitvavo_api_secret

# --- LLM Provider ---
# Options: gemini, openai, anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key       # Only needed if LLM_PROVIDER=openai
# ANTHROPIC_API_KEY=your_anthropic_api_key  # Only needed if LLM_PROVIDER=anthropic
LLM_MODEL=gemini-2.5-flash

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db

# --- Crypto Guardrails & Sizing ---
CRYPTO_BUY_PCT=3.0
CRYPTO_STRONG_BUY_PCT=5.0
CRYPTO_PER_TRADE_CAP_PCT=5.0
CRYPTO_STOP_LOSS_PCT=5.0
CRYPTO_TRAILING_STOP_PCT=3.0
CRYPTO_TAKE_PROFIT_PCT=15.0
CRYPTO_CIRCUIT_BREAKER_CONSECUTIVE_LOSSES=3
CRYPTO_CIRCUIT_BREAKER_CUMULATIVE_LOSS_PCT=15.0
CRYPTO_CIRCUIT_BREAKER_WINDOW_DAYS=7
CRYPTO_GLOBAL_BUDGET_EUR=1000.0
CRYPTO_BUY_COOLDOWN_DAYS=3
CRYPTO_MAX_ALLOCATION_PCT=20.0

# --- Crypto Basket (comma-separated) ---
CRYPTO_BASKET=BTC-EUR,ETH-EUR,SOL-EUR,XRP-EUR,ADA-EUR

# --- Paper Trading ---
# Set to "true" to enable live trading (default: paper mode)
CRYPTO_LIVE_MODE=false
PAPER_TRADING_START_DATE=

# --- Scheduler (UTC) ---
# Crypto: 4H strategy analysis at candle close + Stop-loss / Trailing check every 15 min
CRYPTO_CANDLE_INTERVAL=4h
CRYPTO_STRATEGY_CRON_HOURS=0,4,8,12,16,20
CRYPTO_STOPS_CHECK_CRON_MINUTES=*/15
CRYPTO_SCHEDULE_HOUR=8
CRYPTO_SCHEDULE_MINUTE=0
STOCKS_SCHEDULE_DAY_OF_WEEK=sun
STOCKS_SCHEDULE_HOUR=20
STOCKS_SCHEDULE_MINUTE=0

# --- Score Weights (per asset type) ---
# Format: technical,fundamental,dividend
WEIGHTS_STOCKS=40,35,25
WEIGHTS_ETFS=35,30,35
WEIGHTS_BONDS=20,30,50
# Crypto has no fundamentals/dividends — technical only
WEIGHTS_CRYPTO=100,0,0

# --- Technical Indicator Weights (relative weighting, default 1.0) ---
TECH_WEIGHT_SMA_CROSS=1.0
TECH_WEIGHT_EMA_CROSS=1.0
TECH_WEIGHT_MACD=1.0
TECH_WEIGHT_RSI=1.0
TECH_WEIGHT_ROC=1.0
TECH_WEIGHT_STOCHASTIC=1.0
TECH_WEIGHT_BOLLINGER=1.0
TECH_WEIGHT_OBV=1.0

# --- LLM Synthesis Language ---
# Options: fr, en
SYNTHESIS_LANGUAGE=fr
